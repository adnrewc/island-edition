---
layout: base.njk
title: Island Edition Archive
eleventyNavigation:
  key: Home
  order: 1
permalink: /index.html
stylesheets:
  - /assets/css/home.css
  - /assets/css/archive.css
---

{% from "macros/seo.njk" import jsonld %}
{{ jsonld({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": metadata.site_title,
  "url": metadata.base_url,
  "description": metadata.description,
  "creator": {
    "@type": "Person",
    "name": metadata.author.name,
    "description": metadata.author.bio
  }
}) }}

{% include "components/hero.njk" %}

<section class="section section--narrow" aria-labelledby="about">
  <div class="wrapper">
    <h2 id="about">Inside Island Edition</h2>
    <p class="section__lede">
      Curated by {{ metadata.author.name }}, Island Edition became a weekly habit that translated councillor chatter, grassroots passion, and the quiet wins of islanders into one readable dispatch.
    </p>
    <p>
      Each Wednesday the newsletter paired civic context with neighbourhood stories, spotlighted efforts that might otherwise have gone unnoticed, and steered readers toward the weekend with thoughtful suggestions.
    </p>
    <ul class="feature-list">
      <li><strong>Community spotlights:</strong> interviews with teachers, artists, and volunteers reshaping everyday life across PEI.</li>
      <li><strong>Civic explainers:</strong> readable takes on council debates, infrastructure plans, and the policies moving the island forward.</li>
      <li><strong>Weekend prompts:</strong> curated event ideas, walking routes, and cultural cues for curious locals.</li>
    </ul>
  </div>
</section>

{% if metadata.stats %}
<section class="section section--muted" aria-labelledby="stats">
  <div class="wrapper">
    <h2 id="stats">Archive by the numbers</h2>
    <div class="stat-grid">
      <div class="stat-card">
        <span class="stat-card__number">{{ metadata.stats.issues }}</span>
        <span class="stat-card__label">Issues preserved</span>
      </div>
      <div class="stat-card">
        <span class="stat-card__number">{{ metadata.stats.months_active }}</span>
        <span class="stat-card__label">Months of weekly coverage</span>
      </div>
      <div class="stat-card">
        <span class="stat-card__number">{{ metadata.stats.average_read_time }}</span>
        <span class="stat-card__label">Average reading time</span>
      </div>
    </div>
  </div>
</section>
{% endif %}

<section class="section section--narrow" aria-labelledby="timeline">
  <div class="wrapper">
    <h2 id="timeline">How the newsletter unfolded</h2>
    <ul class="timeline">
      <li>
        <strong>{{ metadata.timeline.launch_year }}</strong>
        <span>Launches with a simple promise: capture the cadence of island life for curious locals and expats.</span>
      </li>
      <li>
        <strong>80 weekly issues</strong>
        <span>A Wednesday ritual packed with reporting, reader Q&amp;As, and curated links that celebrated community wins.</span>
      </li>
      <li>
        <strong>{{ metadata.timeline.sunset_month_year }}</strong>
        <span>{{ metadata.timeline.sunset_reason }}</span>
      </li>
    </ul>
  </div>
</section>

<section class="section section--narrow" aria-labelledby="how-to">
  <div class="wrapper">
    <h2 id="how-to">How to browse the archive</h2>
    <p>
      Use the year groups to jump to a season, or move chronologically to relive the cadence of each Wednesday dispatch. Every issue page reproduces the original layout so you can reference links, photos, and formatting exactly as subscribers received it.
    </p>
  </div>
</section>

<section class="section" id="archive" aria-labelledby="archive-heading">
  <div class="wrapper">
    <h2 id="archive-heading">Newsletter archive</h2>
    {{ jsonld({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Island Edition Archive Issues",
      "url": metadata.base_url + page.url,
      "numberOfItems": issues.issues | length
    }) }}
    {{ jsonld({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": metadata.base_url
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Archive",
          "item": metadata.base_url + page.url
        }
      ]
    }) }}
    {% import "components/archive-list.njk" as archives %}
    {{ archives.archiveList(issues.groups) }}
  </div>
</section>
